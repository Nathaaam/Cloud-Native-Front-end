# Build de producción para S3, servido por API Gateway o CloudFront (scripts/deploy-s3.sh)
# Copia este archivo a .env.production.local (no se versiona) y completa los valores.

# URL de API Gateway, terminada en /api/v1
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/api/v1

# Cognito (App Client público, sin secret)
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_CLIENT_ID=your_app_client_id
VITE_AWS_REGION=us-east-1

# Destino (solo los usa el script; Vite ignora variables sin prefijo VITE_)
S3_BUCKET=nombre-del-bucket
# Opcional: solo si el frontend se sirve con CloudFront (el Learner Lab no lo permite)
CLOUDFRONT_DISTRIBUTION_ID=
