# Frontend Environment Variables Template
# Copy this file to .env.local or .env.development and fill in the actual values
# DO NOT commit .env.local with real secrets to Git

# ===========================
# API Configuration
# ===========================
# Backend BFF Service URL
VITE_API_URL=http://localhost:8090/api/v1

# ===========================
# AWS Cognito Configuration
# ===========================
# User Pool ID and App Client ID (public client, no secret)
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_CLIENT_ID=your_app_client_id

# ===========================
# AWS Region
# ===========================
VITE_AWS_REGION=us-east-1
